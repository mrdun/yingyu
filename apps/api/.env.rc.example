# 本地 RC (Release Candidate) 生产环境变量模板
#
# 用法: 复制为 apps/api/.env.rc (该文件已被 .gitignore 忽略), 按本机实际情况填写。
# 用途: 在本地以「生产模式」(NODE_ENV=prod) 启动后端做 RC 验证, 与开发/测试环境隔离。
#
# ⚠️ 这里只放本机 RC 用的占位/测试值, 绝不要放真实生产密钥。

# 业务库: 使用 RC 专用数据库, 不要指向开发库或测试库
DATABASE_URL="postgres://test:password@localhost:5480/earthworm_rc"
REDIS_URL="redis://127.0.0.1:6379"

# 本地 Logto (docker-compose 中的 logto 服务)
LOGTO_ENDPOINT="http://localhost:3010/"
LOGTO_CLIENT_ID="<本机 Logto M2M 应用 ID>"
LOGTO_CLIENT_SECRET="<本机 Logto M2M 应用密钥>"
LOGTO_M2M_API="https://default.logto.app/api"

# JWT audience 与回调地址
BACKEND_ENDPOINT="http://127.0.0.1:3001/"
PUBLIC_API_BASE_URL="http://127.0.0.1:3001"
CORS_ORIGINS="http://127.0.0.1:4173"

# 默认支付渠道 (RC 用占位凭据, 不会发起真实网关请求)
PAYMENT_PROVIDER="wechat"
WECHAT_APP_ID="rc_placeholder_appid"
WECHAT_MCH_ID="rc_placeholder_mchid"
WECHAT_API_KEY="rc_placeholder_apikey_32_characters"
WECHAT_CERT_PATH="apps/api/rc-placeholder-cert.pem"
WECHAT_CERT_KEY_PATH="apps/api/rc-placeholder-key.pem"

# 健康接口展示的版本号
RELEASE_VERSION="v1.0.0-mvp-rc"
