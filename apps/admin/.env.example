# 管理后台 (apps/admin) 环境变量示例
# 复制为 .env 后按需修改; .env 已被 .gitignore 忽略, 禁止提交任何真实密钥。
# 注意: 这些都是「构建期」注入的公开变量, 会写进前端产物 —— 不要在此放任何机密。

# NestJS API 地址 (管理后台只走 API, 绝不直连数据库)
ADMIN_API_BASE_URL="http://localhost:3001"

# Logto SPA 应用: 管理后台**独立**应用 earthworm-admin (与用户端 earthworm-client 分开,
# 这样用户端无需申请 admin:access)。生产环境请在 Logto 中另行注册并替换此值。
LOGTO_ENDPOINT="http://localhost:3010/"
LOGTO_APP_ID="ak97ylg7x6ru1q5w51vt"

# Logto 资源标识 (换取 access token 的 audience), 必须与后端 BACKEND_ENDPOINT 一致
BACKEND_ENDPOINT="http://localhost:3001/"

# 管理后台自己的回调地址 (端口 3002, 已在 Logto 注册)
LOGTO_SIGN_IN_REDIRECT_URI="http://localhost:3002/callback"
LOGTO_SIGN_OUT_REDIRECT_URI="http://localhost:3002/"
